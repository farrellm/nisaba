{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["dist"],
  "rules": {
    // React 19's automatic JSX runtime needs no React in scope.
    "react/react-in-jsx-scope": "off",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    // Type-aware: guards the NDJSON streaming code and async handlers.
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/strict-boolean-expressions": "warn",
    "import/no-cycle": "error",
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": ["expect", "expectInvariants"]
      }
    ],
    "no-case-declarations": "error",
    "no-empty": "error",
    "no-fallthrough": "error",
    "no-prototype-builtins": "error",
    "no-regex-spaces": "error",
    "no-var": "error",
    "prefer-const": "error",
    "prefer-rest-params": "error",
    "prefer-spread": "error",
    "no-array-constructor": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-namespace": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-unsafe-function-type": "error",
    // Dialogs deliberately focus their first field.
    "jsx-a11y/no-autofocus": "off",
    // Effects return a cleanup on some paths and bail early on others.
    "typescript/consistent-return": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/**/*.ts", "src/**/*.tsx"],
      "plugins": ["typescript", "react"],
      "env": {
        "browser": true
      },
      "rules": {
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "warn",
        "react/static-components": "error",
        "react/use-memo": "error",
        "react/preserve-manual-memoization": "error",
        "react/incompatible-library": "warn",
        "react/immutability": "error",
        "react/globals": "error",
        "react/refs": "error",
        "react/error-boundaries": "error",
        "react/purity": "error",
        "react/set-state-in-render": "error",
        "react/unsupported-syntax": "warn",
        "react/only-export-components": [
          "error",
          {
            "allowConstantExport": true,
            "allowCompoundComponents": true
          }
        ],
        // Dialog-seeding effects; refactor to keyed remounts before raising.
        "react/set-state-in-effect": "warn"
      }
    },
    {
      "files": ["src/api/client.ts"],
      "rules": {
        // The JSON boundary: response bodies become T here by assertion.
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ]
}
